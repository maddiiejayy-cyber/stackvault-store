# Server Port & Mode
PORT=3000
NODE_ENV=development

# Seller Admin Security (change this before going public!)
ADMIN_PASSWORD=stackvault2026
ADMIN_SESSION_SECRET=

# Stripe API Keys (get from https://dashboard.stripe.com/apikeys)
# Use sk_test_ / pk_test_ for testing, sk_live_ / pk_live_ for real payments
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional Automated Delivery Emails via Resend (https://resend.com)
RESEND_API_KEY=
FROM_EMAIL=StackVault <onboarding@resend.dev>

# Public Website URL (recommended in production, e.g. https://yourstore.com)
PUBLIC_URL=
